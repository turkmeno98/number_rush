    <Item class="ModuleScript" referent="RBX00000014">
      <Properties>
        <string name="Name">GameConfig</string>
        <ProtectedString name="Source">local Config = {}

Config.StartingBalance = 100000
Config.StartingInventoryCapacity = 25
Config.StartingIncomeSlots = 3
Config.SpinDuration = 6

Config.Rarities = {
	{Name = "Обычный", BasePrice = 1500, IncomePerHour = 10000},
	{Name = "Необычный", BasePrice = 1800, IncomePerHour = 11000},
	{Name = "Редкий", BasePrice = 3000, IncomePerHour = 12500},
	{Name = "Эпический", BasePrice = 6000, IncomePerHour = 15000},
	{Name = "Легендарный", BasePrice = 15000, IncomePerHour = 18000},
	{Name = "Исключительный", BasePrice = 40000, IncomePerHour = 22000},
}

Config.Profiles = {
	Starter = {
		Name = "Стартовый", Price = 5000, Prestige = 1.00,
		Weights = {5500000, 4300000, 185000, 14900, 99, 1},
	},
	Improved = {
		Name = "Улучшенный", Price = 15000, Prestige = 1.03,
		Weights = {0, 9400000, 580000, 19900, 99, 1},
	},
	Collector = {
		Name = "Коллекционный", Price = 50000, Prestige = 1.06,
		Weights = {0, 0, 9700000, 297000, 2970, 30},
	},
}

-- Сотые доли коэффициента: 200 = x2.00.
Config.DigitValues = {
	["0"] = 200, ["7"] = 190, ["8"] = 180, ["1"] = 165,
	["9"] = 150, ["5"] = 140, ["3"] = 130, ["2"] = 120,
	["6"] = 110, ["4"] = 100,
}
Config.CodeMatchPercent = 5

-- Игровая привязка регионов, не реальная таблица диапазонов связи.
Config.Operators = {
	{Id = "beelink", Name = "БиЛайнк", Codes = {
		{Code = "903", Region = "Москва", ProfileId = "Starter"},
		{Code = "905", Region = "Санкт-Петербург", ProfileId = "Improved"},
		{Code = "909", Region = "Казань", ProfileId = "Collector"},
	}},
	{Id = "mobitel", Name = "Мобител", Codes = {
		{Code = "910", Region = "Москва", ProfileId = "Starter"},
		{Code = "915", Region = "Санкт-Петербург", ProfileId = "Improved"},
		{Code = "919", Region = "Казань", ProfileId = "Collector"},
	}},
	{Id = "megalink", Name = "МегаЛинк", Codes = {
		{Code = "920", Region = "Москва", ProfileId = "Starter"},
		{Code = "925", Region = "Санкт-Петербург", ProfileId = "Improved"},
		{Code = "929", Region = "Казань", ProfileId = "Collector"},
	}},
	{Id = "telenova", Name = "ТелеНова", Codes = {
		{Code = "900", Region = "Москва", ProfileId = "Starter"},
		{Code = "904", Region = "Санкт-Петербург", ProfileId = "Improved"},
		{Code = "951", Region = "Казань", ProfileId = "Collector"},
	}},
}

Config.CodeOffers = {}
for _, operator in Config.Operators do
	for _, offer in operator.Codes do
		assert(type(offer.Code) == "string" and offer.Code:match("^9%d%d$"), "Некорректный код в GameConfig")
		assert(Config.CodeOffers[offer.Code] == nil, "Повторяющийся код: " .. offer.Code)
		assert(Config.Profiles[offer.ProfileId] ~= nil, "Неизвестный профиль у кода " .. offer.Code)
		Config.CodeOffers[offer.Code] = {
			Code = offer.Code, Region = offer.Region,
			OperatorId = operator.Id, OperatorName = operator.Name,
			ProfileId = offer.ProfileId,
		}
	end
end

return Config
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00000005">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX00000015">
      <Properties>
        <string name="Name">GameServer</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local PlayerDataStore = require(script.Parent:WaitForChild("PlayerDataStore"))
local SpinService = require(script.Parent:WaitForChild("SpinService"))
local IncomeSlotService = require(script.Parent:WaitForChild("IncomeSlotService"))
local OnlineIncomeService = require(script.Parent:WaitForChild("OnlineIncomeService"))
local remotes = ReplicatedStorage:WaitForChild("NumberRushRemotes")
local spinRequest = remotes:WaitForChild("SpinRequest")
local spinResult = remotes:WaitForChild("SpinResult")
local slotRequest = remotes:WaitForChild("SlotRequest")
local slotResult = remotes:WaitForChild("SlotResult")
local sessions, loading = {}, {}
local shuttingDown = false

local function send(player, packet)
	if player.Parent == Players then spinResult:FireClient(player, packet) end
end

local function publishInventory(player, session)
	local folder = player:FindFirstChild("NumberInventory")
	if not folder then folder = Instance.new("Folder"); folder.Name = "NumberInventory"; folder.Parent = player end
	folder:ClearAllChildren()
	local count = 0
	for issuanceId, item in pairs(session.Data.Inventory) do
		local entry = Instance.new("Folder")
		entry.Name = tostring(issuanceId)
		for key, value in pairs(item) do
			local valueType = type(value)
			if valueType == "string" or valueType == "number" or valueType == "boolean" then entry:SetAttribute(key, value) end
		end
		entry.Parent = folder
		count += 1
	end
	player:SetAttribute("InventoryCount", count)
	player:SetAttribute("NextSpinSequence", session.Data.NextSpinSequence or 1)
end

local function publishSlots(player, state)
	local folder = player:FindFirstChild("IncomeSlots")
	if not folder then folder = Instance.new("Folder"); folder.Name = "IncomeSlots"; folder.Parent = player end
	folder:ClearAllChildren()
	folder:SetAttribute("Revision", state.Revision)
	folder:SetAttribute("ServerTime", state.ServerTime)
	for _, row in ipairs(state.Slots) do
		local entry = Instance.new("Folder")
		entry.Name = tostring(row.SlotIndex)
		for key, value in pairs(row) do
			local kind = type(value)
			if kind == "string" or kind == "number" or kind == "boolean" then entry:SetAttribute(key, value) end
		end
		entry.Parent = folder
	end
	player:SetAttribute("SlotRevision", state.Revision)
	player:SetAttribute("ActiveIncomeSlotCount", state.ActiveCount)
	player:SetAttribute("TotalBaseIncomePerHour", state.TotalBaseIncomePerHour)
	player:SetAttribute("IncomeEnabled", state.IncomeEnabled == true)
end

local function closeProfile(player)
	local session = sessions[player]
	if not session or session.Closing then return end
	OnlineIncomeService.Stop(session)
	session.Closing = true
	player:SetAttribute("DataReady", false)
	if session.BalanceConnection then session.BalanceConnection:Disconnect() end
	local deadline = os.clock() + 20
	while session.Busy and os.clock() &lt; deadline do task.wait(0.1) end
	local saved, saveError = false, "Не удалось завершить сохранение"
	for attempt = 1, 3 do
		if os.clock() &gt;= deadline then break end
		if not session.Busy then
			saved, saveError = PlayerDataStore.Save(session, true)
			if saved then break end
		end
		task.wait(1)
	end
	if saved then
		print("NUMBER RUSH: профиль сохранён — " .. player.Name)
	else
		warn("NUMBER RUSH: ошибка сохранения — " .. player.Name .. ": " .. tostring(saveError))
	end
	sessions[player] = nil
end

local function stopSession(player, message)
	player:SetAttribute("DataReady", false)
	task.spawn(closeProfile, player)
	if player.Parent == Players then player:Kick(message) end
end

local function setupPlayer(player)
	if sessions[player] or loading[player] or shuttingDown then return end
	loading[player] = true
	player:SetAttribute("DataReady", false)
	local session, loadError = nil, nil
	for attempt = 1, 3 do
		if player.Parent ~= Players or shuttingDown then break end
		session, loadError = PlayerDataStore.Load(player.UserId)
		if session then break end
		if attempt &lt; 3 then task.wait(2) end
	end
	loading[player] = nil
	if not session then
		if player.Parent == Players and not shuttingDown then
			warn("NUMBER RUSH: ошибка загрузки: " .. tostring(loadError))
			player:Kick("Профиль недоступен. Подключитесь немного позже.")
		end
		return
	end
	sessions[player] = session
	session.NextSaveAt = os.clock() + 30
	if player.Parent ~= Players or shuttingDown then closeProfile(player); return end
	if session.Data.NextSpinSequence == nil then session.Data.NextSpinSequence = 1 end
	local recovered, recoveryError, recoveryDetails = SpinService.Recover(session)
	if not recovered then
		warn("NUMBER RUSH: восстановление выдачи: " .. tostring(recoveryDetails or recoveryError))
		stopSession(player, "Не удалось восстановить профиль. Подключитесь немного позже.")
		return
	end
	if player.Parent ~= Players or shuttingDown then closeProfile(player); return end
	local slots, slotError, slotDetails = IncomeSlotService.Initialize(session)
	if not slots then
		warn("NUMBER RUSH: проверка слотов: " .. tostring(slotDetails or slotError))
		stopSession(player, "Не удалось проверить доходные слоты. Подключитесь немного позже.")
		return
	end
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local rubles = Instance.new("IntValue")
	rubles.Name = "Рубли"
	rubles.Value = session.Data.Balance
	rubles.Parent = leaderstats
	session.BalanceValue = rubles
	player:SetAttribute("InventoryCapacity", session.Data.InventoryCapacity)
	player:SetAttribute("IncomeSlotCount", session.Data.IncomeSlotCount)
	session.BalanceConnection = rubles:GetPropertyChangedSignal("Value"):Connect(function()
		if session.Closing or session.Closed then return end
		local value = rubles.Value
		if value &lt; 0 or value &gt; 1000000000000 then
			rubles.Value = session.Data.Balance
			warn("NUMBER RUSH: отклонён некорректный баланс")
			return
		end
		session.Data.Balance = value
	end)
	local incomeReady, incomeError = OnlineIncomeService.Initialize(session)
	if not incomeReady then
		warn("NUMBER RUSH: проверка дохода: " .. tostring(incomeError))
		stopSession(player, "Не удалось проверить доход. Подключитесь немного позже.")
		return
	end
	slots.State.IncomeEnabled = true
	publishInventory(player, session)
	publishSlots(player, slots.State)
	leaderstats.Parent = player
	player:SetAttribute("DataReady", true)
	print("NUMBER RUSH: профиль загружен. Баланс: " .. tostring(session.Data.Balance))
	print("NUMBER RUSH: доходных слотов доступно: " .. tostring(slots.State.SlotCount))
end

local messages = {
	InvalidCode = "Выберите доступный код.",
	InvalidSequence = "Обновите выбор и повторите попытку.",
	StaleRequest = "Состояние терминала обновилось. Повторите попытку.",
	Busy = "Прокрутка уже выполняется.", SessionUnavailable = "Профиль временно недоступен.",
	NotEnoughMoney = "Недостаточно рублей.", InventoryFull = "В коллекции нет свободных мест.",
	GenerationFailed = "Не удалось подготовить номер. Повторите попытку.",
	RecoveryRequired = "Для проверки выдачи нужно переподключиться.",
}

local function sendError(player, session, sequence, code)
	send(player, {
		Status = "Error", ErrorCode = code, Sequence = sequence,
		Message = messages[code] or "Не удалось выполнить прокрутку.",
		NextSequence = session and (session.Data.NextSpinSequence or 1) or nil,
		Ready = player:GetAttribute("DataReady") == true,
	})
end

spinRequest.OnServerEvent:Connect(function(player, code, sequence)
	local session = sessions[player]
	if not session or player:GetAttribute("DataReady") ~= true then sendError(player, session, nil, "SessionUnavailable"); return end
	local now = os.clock()
	if session.LastRequestAt and now - session.LastRequestAt &lt; 0.25 then return end
	session.LastRequestAt = now
	if session.RequestBusy or session.SpinBusy or session.SlotBusy then sendError(player, session, nil, "Busy"); return end
	if type(code) ~= "string" or not Config.CodeOffers[code] then sendError(player, session, nil, "InvalidCode"); return end
	if type(sequence) ~= "number" or sequence % 1 ~= 0 or sequence &lt; 1 or sequence &gt; 1000000000 then sendError(player, session, nil, "InvalidSequence"); return end
	local lastSpin = session.Data.LastSpin
	local repeated = lastSpin and lastSpin.Sequence == sequence
	if not repeated then
		if sequence ~= (session.Data.NextSpinSequence or 1) then sendError(player, session, sequence, "StaleRequest"); return end
		local offer = Config.CodeOffers[code]
		local profile = Config.Profiles[offer.ProfileId]
		if session.Data.Balance &lt; profile.Price then sendError(player, session, sequence, "NotEnoughMoney"); return end
		local count = 0
		for _ in pairs(session.Data.Inventory) do count += 1 end
		if count &gt;= session.Data.InventoryCapacity then sendError(player, session, sequence, "InventoryFull"); return end
	end
	session.RequestBusy = true
	if not repeated then send(player, {Status = "Started", Sequence = sequence, Code = code, Duration = Config.SpinDuration}) end
	local receipt, errorCode, details = SpinService.Start(session, code, sequence)
	session.RequestBusy = false
	if not receipt then
		warn("NUMBER RUSH: прокрутка: " .. tostring(errorCode) .. " " .. tostring(details or ""))
		if errorCode == "RecoveryRequired" then
			player:SetAttribute("DataReady", false)
			sendError(player, session, sequence, errorCode)
			stopSession(player, "Профиль временно недоступен. Переподключитесь для проверки выдачи.")
		else
			sendError(player, session, sequence, errorCode)
		end
		return
	end
	if session.Closing or session.Closed or player.Parent ~= Players then return end
	publishInventory(player, session)
	receipt.Balance = session.Data.Balance
	receipt.NextSequence = session.Data.NextSpinSequence or 1
	receipt.InventoryCount = player:GetAttribute("InventoryCount")
	send(player, receipt)
end)

local slotMessages = {
	Busy = "Дождитесь завершения текущего действия.",
	SessionUnavailable = "Профиль временно недоступен.",
	InvalidAction = "Неизвестное действие со слотом.",
	InvalidSlot = "Выберите доступный доходный слот.",
	InvalidRevision = "Обновите состояние слотов.",
	StaleSlots = "Состояние слотов изменилось. Проверьте выбор и повторите действие.",
	InvalidItem = "Выберите номер из своей коллекции.",
	ItemNotOwned = "Этого номера нет в вашей коллекции.",
	AlreadyAssigned = "Этот номер уже установлен в другом слоте.",
	ItemUnavailable = "Номер занят другим действием.",
	LastIncomeSource = "Сначала установите другой номер: последний занятый слот нельзя оставить пустым.",
	Cooldown = "Этот слот пока нельзя заменить.",
	RevisionLimit = "Не удалось обновить слоты. Обратитесь к разработчику.",
	RecoveryRequired = "Переподключитесь для проверки сохранённого назначения.",
}

local function sendSlotError(player, session, code, details)
	local message = slotMessages[code] or "Не удалось изменить доходный слот."
	if code == "Cooldown" and type(details) == "number" then
		message = "Замена этого слота доступна через " .. tostring(math.ceil(details / 60)) .. " мин."
	end
	local state = nil
	if session and code == "StaleSlots" then
		local response = IncomeSlotService.GetState(session)
		if response then state = response.State end
	end
	if player.Parent == Players then
		slotResult:FireClient(player, {Status = "Error", ErrorCode = code, Message = message,
			State = state, Ready = player:GetAttribute("DataReady") == true})
	end
end

slotRequest.OnServerEvent:Connect(function(player, action, index, issuanceId, revision)
	local session = sessions[player]
	if not session or player:GetAttribute("DataReady") ~= true then
		sendSlotError(player, session, "SessionUnavailable"); return
	end
	local now = os.clock()
	if session.LastSlotRequestAt and now - session.LastSlotRequestAt &lt; 0.2 then
		if not session.LastSlotThrottleReplyAt or now - session.LastSlotThrottleReplyAt &gt;= 1 then
			session.LastSlotThrottleReplyAt = now
			sendSlotError(player, session, "Busy")
		end
		return
	end
	session.LastSlotRequestAt = now
	if action ~= "GetState" and action ~= "Install" and action ~= "Remove" then
		sendSlotError(player, session, "InvalidAction"); return
	end
	local result, code, details
	if action == "GetState" then
		result, code, details = IncomeSlotService.GetState(session)
	elseif action == "Install" then
		result, code, details = IncomeSlotService.Install(session, index, issuanceId, revision)
	else
		result, code, details = IncomeSlotService.Remove(session, index, revision)
	end
	if not result then
		if code == "RecoveryRequired" then
			player:SetAttribute("DataReady", false)
			warn("NUMBER RUSH: сохранение слота: " .. tostring(details))
			sendSlotError(player, session, code)
			stopSession(player, "Назначение слота требует проверки. Подключитесь немного позже.")
		else
			sendSlotError(player, session, code, details)
		end
		return
	end
	if session.Closing or session.Closed or player.Parent ~= Players then return end
	if result.Status == "Success" then publishInventory(player, session) end
	publishSlots(player, result.State)
	slotResult:FireClient(player, result)
end)

Players.PlayerRemoving:Connect(closeProfile)
Players.PlayerAdded:Connect(setupPlayer)
for _, player in Players:GetPlayers() do task.spawn(setupPlayer, player) end

task.spawn(function()
	while not shuttingDown do
		task.wait(1)
		for player, session in pairs(sessions) do
			if session.Closing or session.Closed or session.NeedsRecovery or session.Busy
				or session.SpinBusy or session.RequestBusy or session.SlotBusy then continue end
			local ok, reason = OnlineIncomeService.Accrue(session)
			if not ok then
				session.NeedsRecovery = true
				warn("NUMBER RUSH: начисление дохода: " .. tostring(reason))
				stopSession(player, "Доход требует проверки. Подключитесь немного позже.")
			end
		end
	end
end)

task.spawn(function()
	while not shuttingDown do
		task.wait(5)
		for player, session in pairs(sessions) do
			if session.Closing or session.Closed then continue end
			if os.time() &gt;= session.LeaseUntil - 15 then
				stopSession(player, "Связь с хранилищем потеряна. Подключитесь немного позже.")
				continue
			end
			if session.SpinBusy or session.RequestBusy or session.SlotBusy then continue end
			if os.clock() &gt;= session.NextSaveAt and not session.Busy then
				session.NextSaveAt = os.clock() + 30
				task.spawn(function()
					if session.Closing or session.Closed or session.SpinBusy or session.RequestBusy or session.SlotBusy then return end
					local saved, saveError = PlayerDataStore.Save(session, false)
					if not saved then warn("NUMBER RUSH: ошибка автосохранения: " .. tostring(saveError)) end
				end)
			end
		end
	end
end)

game:BindToClose(function()
	shuttingDown = true
	for player in pairs(sessions) do task.spawn(closeProfile, player) end
	local deadline = os.clock() + 25
	while os.clock() &lt; deadline do
		if next(sessions) == nil and next(loading) == nil then break end
		task.wait(0.1)
	end
end)
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000016">
      <Properties>
        <string name="Name">IncomeSlotService</string>
        <ProtectedString name="Source">-- Assignment service; online income is settled by a server-session hook.
local PlayerDataStore = require(script.Parent:WaitForChild("PlayerDataStore"))
local IncomeSlotService = {}
IncomeSlotService.CooldownSeconds = 3600
IncomeSlotService.MaxSlots = 5

local function integer(value, minimum, maximum)
	return type(value) == "number" and value % 1 == 0
		and value &gt;= minimum and value &lt;= maximum
end

local function available(session)
	return type(session) == "table" and not session.Closed and not session.Closing
		and type(session.LeaseUntil) == "number" and session.LeaseUntil &gt; os.time() + 10
end

-- The profile and its slot book are authoritative, never client attributes.
local function validateBook(data)
	if type(data) ~= "table" or type(data.Inventory) ~= "table"
		or type(data.IncomeSlots) ~= "table"
		or not integer(data.IncomeSlotCount, 1, IncomeSlotService.MaxSlots)
	then return false, "InvalidSlotBook" end
	if data.SlotRevision ~= nil and not integer(data.SlotRevision, 0, 1000000000000) then
		return false, "InvalidSlotRevision"
	end
	local assigned = {}
	for key, slot in pairs(data.IncomeSlots) do
		local index = tonumber(key)
		if type(key) ~= "string" or not integer(index, 1, data.IncomeSlotCount)
			or tostring(index) ~= key or type(slot) ~= "table"
		then return false, "InvalidSlotRecord" end
		if slot.ChangedAt ~= nil and not integer(slot.ChangedAt, 0, 1000000000000) then
			return false, "InvalidSlotTimestamp"
		end
		if slot.IssuanceId ~= nil then
			local id = slot.IssuanceId
			local item = data.Inventory[id]
			if type(id) ~= "string" or assigned[id] or type(item) ~= "table"
				or item.IssuanceId ~= id or item.Location ~= "IncomeSlot"
				or item.IncomeSlotIndex ~= index or slot.ChangedAt == nil
			then return false, "InconsistentSlotOwnership" end
			assigned[id] = index
		end
	end
	for id, item in pairs(data.Inventory) do
		if type(id) ~= "string" or type(item) ~= "table" or item.IssuanceId ~= id
			or type(item.DisplayNumber) ~= "string" or type(item.Location) ~= "string"
			or not integer(item.IncomePerHour, 0, 1000000000)
		then return false, "InvalidInventoryItem" end
		if item.Location == "IncomeSlot" then
			if assigned[id] ~= item.IncomeSlotIndex or not assigned[id] then
				return false, "OrphanIncomeSlotItem"
			end
		elseif item.IncomeSlotIndex ~= nil then
			return false, "UnexpectedSlotIndex"
		end
	end
	if data.SlotRevision == nil then data.SlotRevision = 0 end
	return true
end

local function snapshot(data, incomeEnabled)
	local now = os.time()
	local state = {Revision = data.SlotRevision, SlotCount = data.IncomeSlotCount,
		ActiveCount = 0, TotalBaseIncomePerHour = 0, IncomeEnabled = incomeEnabled == true, ServerTime = now, Slots = {}}
	for index = 1, data.IncomeSlotCount do
		local slot = data.IncomeSlots[tostring(index)]
		local changedAt = slot and slot.ChangedAt
		local nextChangeAt = changedAt and (changedAt + IncomeSlotService.CooldownSeconds) or 0
		local row = {SlotIndex = index, LastChangedAt = changedAt or 0,
			NextChangeAt = nextChangeAt, CooldownRemaining = math.max(0, nextChangeAt - now)}
		if slot and slot.IssuanceId then
			local item = data.Inventory[slot.IssuanceId]
			row.IssuanceId = slot.IssuanceId
			row.DisplayNumber = item.DisplayNumber
			row.RarityName = item.RarityName
			row.IncomePerHour = item.IncomePerHour
			state.ActiveCount = state.ActiveCount + 1
			state.TotalBaseIncomePerHour = state.TotalBaseIncomePerHour + item.IncomePerHour
		end
		table.insert(state.Slots, row)
	end
	return state
end

local function run(session, callback)
	if not available(session) then return nil, "SessionUnavailable" end
	if session.NeedsRecovery then return nil, "RecoveryRequired" end
	if type(session.Data) ~= "table" then return nil, "RecoveryRequired", "MissingProfileData" end
	if session.SlotBusy or session.SpinBusy or session.RequestBusy or session.Busy
		or session.Data.PendingSpin then return nil, "Busy" end
	session.SlotBusy = true
	local ok, result, code, details = pcall(function()
		local valid, reason = validateBook(session.Data)
		if not valid then return nil, "RecoveryRequired", reason end
		return callback()
	end)
	session.SlotBusy = false
	if not ok then session.NeedsRecovery = true; return nil, "RecoveryRequired", tostring(result) end
	if code == "RecoveryRequired" then session.NeedsRecovery = true end
	return result, code, details
end

local function checkRequest(data, index, revision)
	if not integer(index, 1, data.IncomeSlotCount) then return false, "InvalidSlot" end
	if not integer(revision, 0, 1000000000000) then return false, "InvalidRevision" end
	if revision ~= data.SlotRevision then return false, "StaleSlots" end
	if data.SlotRevision &gt;= 1000000000000 then return false, "RevisionLimit" end
	return true
end

local function saveMutation(session)
	if not available(session) then return nil, "RecoveryRequired", "SessionClosing" end
	if session.UpdateIncomeRate then
		local ok, reason = session.UpdateIncomeRate()
		if not ok then return nil, "RecoveryRequired", reason end
	end
	local saved, reason = PlayerDataStore.Save(session, false)
	-- On an unknown write outcome retain the consistent new state; never roll back blindly.
	if not saved then return nil, "RecoveryRequired", tostring(reason) end
	if not available(session) then return nil, "RecoveryRequired", "SessionClosing" end
	return {Status = "Success", State = snapshot(session.Data, session.IncomeClock ~= nil)}
end

function IncomeSlotService.Initialize(session)
	return run(session, function() return {Status = "Ready", State = snapshot(session.Data, session.IncomeClock ~= nil)} end)
end

IncomeSlotService.GetState = IncomeSlotService.Initialize

function IncomeSlotService.Install(session, index, issuanceId, revision)
	return run(session, function()
		local data = session.Data
		local valid, code = checkRequest(data, index, revision)
		if not valid then return nil, code end
		if type(issuanceId) ~= "string" or #issuanceId == 0 or #issuanceId &gt; 64 then return nil, "InvalidItem" end
		local item = data.Inventory[issuanceId]
		if not item then return nil, "ItemNotOwned" end
		local key = tostring(index)
		local slot = data.IncomeSlots[key]
		if slot and slot.IssuanceId == issuanceId then
			return {Status = "Unchanged", State = snapshot(data, session.IncomeClock ~= nil)}
		end
		if item.Location == "IncomeSlot" then return nil, "AlreadyAssigned" end
		if item.Location ~= "Inventory" then return nil, "ItemUnavailable" end
		local now = os.time()
		if slot and slot.ChangedAt and now &lt; slot.ChangedAt + IncomeSlotService.CooldownSeconds then
			return nil, "Cooldown", slot.ChangedAt + IncomeSlotService.CooldownSeconds - now
		end
		if slot and slot.IssuanceId then
			local previous = data.Inventory[slot.IssuanceId]
			previous.Location = "Inventory"
			previous.IncomeSlotIndex = nil
		end
		data.IncomeSlots[key] = {IssuanceId = issuanceId, ChangedAt = now}
		item.Location = "IncomeSlot"
		item.IncomeSlotIndex = index
		data.SlotRevision = data.SlotRevision + 1
		return saveMutation(session)
	end)
end

function IncomeSlotService.Remove(session, index, revision)
	return run(session, function()
		local data = session.Data
		local valid, code = checkRequest(data, index, revision)
		if not valid then return nil, code end
		local slot = data.IncomeSlots[tostring(index)]
		if not slot or not slot.IssuanceId then return {Status = "Unchanged", State = snapshot(data, session.IncomeClock ~= nil)} end
		local activeCount = 0
		for _, record in pairs(data.IncomeSlots) do
			if record.IssuanceId then activeCount = activeCount + 1 end
		end
		if activeCount &lt;= 1 then return nil, "LastIncomeSource" end
		local item = data.Inventory[slot.IssuanceId]
		item.Location = "Inventory"
		item.IncomeSlotIndex = nil
		slot.IssuanceId = nil
		-- Keep ChangedAt: removing an item must not reset the replacement cooldown.
		data.SlotRevision = data.SlotRevision + 1
		return saveMutation(session)
	end)
end

return IncomeSlotService
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000017">
      <Properties>
        <string name="Name">NumberEconomy</string>
        <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local NumberRules = require(script.Parent:WaitForChild("NumberRules"))
local NumberEconomy = {}

function NumberEconomy.Evaluate(digits, code, profileId)
	assert(type(code) == "string" and code:match("^9%d%d$"), "Код должен быть строкой из трёх цифр, начиная с 9")
	local profile = Config.Profiles[profileId]
	assert(profile, "Неизвестный профиль прокрутки")
	local rarityIndex = NumberRules.GetRarity(digits)
	local rarity = Config.Rarities[rarityIndex]
	local digitTotal = 0
	for i = 1, 7 do digitTotal += Config.DigitValues[digits:sub(i, i)] end
	local hasCodeMatch = digits:sub(1, 3) == code or digits:sub(5, 7) == code
	local matchPoints = 100
	if hasCodeMatch then matchPoints += Config.CodeMatchPercent end
	local prestigePoints = math.floor(profile.Prestige * 100 + 0.5)
	local numerator = rarity.BasePrice * digitTotal * prestigePoints * matchPoints
	local denominator = 7 * 100 * 100 * 100
	local salePrice = math.floor((numerator + denominator / 2) / denominator)
	return {
		FullNumber = "7" .. code .. digits,
		DisplayNumber = string.format("+7 (%s) %s-%s-%s", code, digits:sub(1, 3), digits:sub(4, 5), digits:sub(6, 7)),
		RarityIndex = rarityIndex, RarityName = rarity.Name,
		BasePrice = rarity.BasePrice, SalePrice = salePrice, IncomePerHour = rarity.IncomePerHour,
		DigitMultiplier = digitTotal / 700, PrestigeMultiplier = prestigePoints / 100,
		CodeMatchMultiplier = matchPoints / 100, HasCodeMatch = hasCodeMatch,
	}
end

return NumberEconomy
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000018">
      <Properties>
        <string name="Name">NumberGenerator</string>
        <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local NumberRules = require(script.Parent:WaitForChild("NumberRules"))
local NumberGenerator = {}
local random = Random.new()
local legendaryNumbers = nil

local function getLegendaryNumbers()
	if legendaryNumbers then return legendaryNumbers end
	local list, seen = {}, {}
	local function add(number)
		if not seen[number] and NumberRules.GetRarity(number) == 5 then
			seen[number] = true
			table.insert(list, number)
		end
	end
	for digit = 0, 9 do
		local repeated = string.rep(tostring(digit), 6)
		for other = 0, 9 do
			add(repeated .. tostring(other))
			add(tostring(other) .. repeated)
		end
	end
	for first = 0, 9 do
		for second = 0, 9 do
			if first ~= second then
				local a, b = tostring(first), tostring(second)
				add(a .. b .. a .. b .. a .. b .. a)
			end
		end
	end
	for start = 0, 3 do
		local ascending, descending = "", ""
		for offset = 0, 6 do
			ascending ..= tostring(start + offset)
			descending ..= tostring(start + 6 - offset)
		end
		add(ascending)
		add(descending)
	end
	assert(#list == 278, "Ошибка: ожидалось 278 легендарных комбинаций")
	legendaryNumbers = list
	return list
end

function NumberGenerator.RollRarity(profileId)
	local profile = Config.Profiles[profileId]
	assert(profile, "Неизвестный профиль прокрутки")
	local totalWeight = 0
	for _, weight in profile.Weights do
		assert(type(weight) == "number" and weight &gt;= 0 and weight % 1 == 0, "Вес категории должен быть целым неотрицательным числом")
		totalWeight += weight
	end
	assert(totalWeight == 10000000, "Сумма весов профиля должна быть 10 миллионов")
	local roll = random:NextInteger(1, totalWeight)
	local accumulated = 0
	for rarityIndex, weight in profile.Weights do
		accumulated += weight
		if roll &lt;= accumulated then return rarityIndex end
	end
	error("Не удалось выбрать категорию")
end

function NumberGenerator.GenerateDigits(rarityIndex)
	assert(type(rarityIndex) == "number" and rarityIndex % 1 == 0 and rarityIndex &gt;= 1 and rarityIndex &lt;= #Config.Rarities, "Некорректный индекс категории")
	if rarityIndex == 6 then return string.rep(tostring(random:NextInteger(0, 9)), 7) end
	if rarityIndex == 5 then
		local list = getLegendaryNumbers()
		return list[random:NextInteger(1, #list)]
	end
	for attempt = 1, 10000 do
		local number = string.format("%07d", random:NextInteger(0, 9999999))
		if NumberRules.GetRarity(number) == rarityIndex then return number end
		if attempt % 250 == 0 then task.wait() end
	end
	return nil, "Не удалось подобрать комбинацию"
end

function NumberGenerator.Generate(profileId)
	local rarityIndex = NumberGenerator.RollRarity(profileId)
	local digits, generationError = NumberGenerator.GenerateDigits(rarityIndex)
	if not digits then return nil, generationError end
	return {Digits = digits, RarityIndex = rarityIndex, RarityName = Config.Rarities[rarityIndex].Name, ProfileId = profileId}
end

return NumberGenerator
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000019">
      <Properties>
        <string name="Name">NumberRegistry</string>
        <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local storeName = "NR_Numbers_LIVE_v1"
if RunService:IsStudio() then storeName = "NR_Numbers_DEV_v1" end
local store = DataStoreService:GetDataStore(storeName)
local NumberRegistry = {}

local function validateArguments(fullNumber, userId, operationId)
	assert(type(fullNumber) == "string" and #fullNumber == 11 and fullNumber:match("^79%d+$"), "Некорректный полный номер")
	assert(type(userId) == "number" and userId % 1 == 0, "Некорректный UserId")
	assert(type(operationId) == "string" and #operationId &gt; 0 and #operationId &lt;= 64, "Некорректный идентификатор операции")
end

local function validRecord(record)
	if type(record) ~= "table" or record.SchemaVersion ~= 1 or type(record.Generation) ~= "number" or record.Generation &lt; 1 or record.Generation % 1 ~= 0 then return false end
	if record.State == "Free" then return true end
	if record.State ~= "Reserved" and record.State ~= "Owned" then return false end
	return type(record.OwnerId) == "number" and type(record.OperationId) == "string" and type(record.IssuanceId) == "string"
end

local function updateRecord(fullNumber, transform)
	local rejectionReason = "Rejected"
	local success, result = pcall(function()
		return store:UpdateAsync(fullNumber, function(oldRecord)
			if oldRecord ~= nil and not validRecord(oldRecord) then rejectionReason = "InvalidRecord"; return nil end
			local updated, reason = transform(oldRecord)
			if updated == nil then rejectionReason = reason or "Rejected" end
			return updated
		end)
	end)
	if not success then return nil, "StorageError", tostring(result) end
	if result == nil then return nil, rejectionReason end
	return result
end

function NumberRegistry.Reserve(fullNumber, userId, operationId)
	validateArguments(fullNumber, userId, operationId)
	local issuanceId = HttpService:GenerateGUID(false)
	return updateRecord(fullNumber, function(oldRecord)
		if oldRecord and oldRecord.State ~= "Free" then
			if oldRecord.OwnerId == userId and oldRecord.OperationId == operationId then return oldRecord end
			return nil, "Occupied"
		end
		local generation = 1
		if oldRecord then generation = oldRecord.Generation + 1 end
		return {SchemaVersion = 1, State = "Reserved", OwnerId = userId, OperationId = operationId, IssuanceId = issuanceId, Generation = generation, UpdatedAt = os.time()}
	end)
end

function NumberRegistry.Confirm(fullNumber, userId, operationId)
	validateArguments(fullNumber, userId, operationId)
	return updateRecord(fullNumber, function(record)
		if not record or record.State == "Free" then return nil, "NotReserved" end
		if record.OwnerId ~= userId or record.OperationId ~= operationId then return nil, "OwnerMismatch" end
		if record.State == "Owned" then return record end
		record.State = "Owned"
		record.UpdatedAt = os.time()
		return record
	end)
end

function NumberRegistry.Cancel(fullNumber, userId, operationId)
	validateArguments(fullNumber, userId, operationId)
	return updateRecord(fullNumber, function(record)
		if not record then return nil, "NotReserved" end
		if record.State == "Free" and record.OperationId == operationId and record.LastOwnerId == userId then return record end
		if record.OwnerId ~= userId or record.OperationId ~= operationId then return nil, "OwnerMismatch" end
		if record.State == "Owned" then return nil, "AlreadyOwned" end
		if record.State ~= "Reserved" then return nil, "NotReserved" end
		record.State = "Free"
		record.LastOwnerId = userId
		record.OwnerId = nil
		record.UpdatedAt = os.time()
		return record
	end)
end

return NumberRegistry
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000020">
      <Properties>
        <string name="Name">NumberRules</string>
        <ProtectedString name="Source">local NumberRules = {}

function NumberRules.GetRarity(number)
	assert(type(number) == "string" and number:match("^%d%d%d%d%d%d%d$"), "Номер должен быть строкой из семи цифр")
	local digits = {}
	for i = 1, 7 do
		digits[i] = tonumber(number:sub(i, i))
	end
	local run, longestRun = 1, 1
	local ascending, descending, longestSequence = 1, 1, 1
	for i = 2, 7 do
		if digits[i] == digits[i - 1] then run += 1 else run = 1 end
		longestRun = math.max(longestRun, run)
		local difference = digits[i] - digits[i - 1]
		if difference == 1 then ascending += 1 else ascending = 1 end
		if difference == -1 then descending += 1 else descending = 1 end
		longestSequence = math.max(longestSequence, ascending, descending)
	end
	if longestRun == 7 then return 6 end
	local alternating = digits[1] ~= digits[2] and number:sub(1, 5) == number:sub(3, 7)
	if longestRun &gt;= 6 or longestSequence == 7 or alternating then return 5 end
	local fullMirror = number == number:reverse()
	local repeatedBlock = number:sub(2, 4) == number:sub(5, 7)
		and not (digits[2] == digits[3] and digits[3] == digits[4])
	if fullMirror or longestRun &gt;= 5 or repeatedBlock then return 4 end
	local threePairs = digits[2] == digits[3] and digits[4] == digits[5]
		and digits[6] == digits[7] and digits[2] ~= digits[4]
		and digits[2] ~= digits[6] and digits[4] ~= digits[6]
	local alternatingEnding = digits[4] == digits[6] and digits[5] == digits[7] and digits[4] ~= digits[5]
	if longestRun &gt;= 4 or longestSequence &gt;= 5 or threePairs or alternatingEnding then return 3 end
	local ending = number:sub(4, 7)
	if longestRun &gt;= 2 or longestSequence &gt;= 3 or ending == ending:reverse() then return 2 end
	return 1
end

return NumberRules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000021">
      <Properties>
        <string name="Name">OnlineIncomeService</string>
        <ProtectedString name="Source">-- No offline payment: the monotonic clock exists only for this server session.
local OnlineIncomeService = {}
local MILLIS_PER_HOUR = 3600000
local MAX_BALANCE = 1000000000000

local function integer(value, minimum, maximum)
	return type(value) == "number" and value % 1 == 0 and value &gt;= minimum and value &lt;= maximum
end

local function rate(data)
	local total, seen = 0, {}
	for index = 1, data.IncomeSlotCount do
		local slot = data.IncomeSlots[tostring(index)]
		if slot and slot.IssuanceId then
			local id = slot.IssuanceId
			local item = data.Inventory[id]
			if seen[id] or type(item) ~= "table" or item.IssuanceId ~= id
				or item.Location ~= "IncomeSlot" or item.IncomeSlotIndex ~= index
				or not integer(item.IncomePerHour, 0, 1000000000) then
				return nil, "InvalidIncomeItem"
			end
			seen[id] = true
			total = total + item.IncomePerHour
		end
	end
	return total
end

function OnlineIncomeService.Accrue(session)
	if not session.IncomeClock or session.Closed or session.NeedsRecovery then return true end
	if os.time() &gt;= session.LeaseUntil - 10 then return true end
	local data = session.Data
	if not integer(data.IncomeRemainder, 0, MILLIS_PER_HOUR - 1)
		or not integer(data.Balance, 0, MAX_BALANCE) then return false, "InvalidIncomeBalance" end
	local now = session.IncomeStoppedAt or math.floor(os.clock() * 1000)
	local elapsed = now - session.IncomeClock
	if elapsed &lt;= 0 then return true end
	-- The lease bounds normal elapsed time; reject corrupt clock state instead of overpaying.
	if elapsed &gt; 3600000 then return false, "InvalidIncomeClock" end
	local numerator = data.IncomeRemainder + session.IncomeRate * elapsed
	if numerator &gt; 9007199254740991 then return false, "IncomePrecisionLimit" end
	local earned = math.floor(numerator / MILLIS_PER_HOUR)
	data.IncomeRemainder = numerator % MILLIS_PER_HOUR
	data.Balance = math.min(MAX_BALANCE, data.Balance + earned)
	if data.Balance == MAX_BALANCE then data.IncomeRemainder = 0 end
	session.IncomeClock = now
	if session.BalanceValue then session.BalanceValue.Value = data.Balance end
	return true
end

function OnlineIncomeService.Initialize(session)
	local remainder = session.Data.IncomeRemainder
	if remainder ~= nil and not integer(remainder, 0, MILLIS_PER_HOUR - 1) then
		return false, "InvalidIncomeRemainder"
	end
	local currentRate, reason = rate(session.Data)
	if not currentRate then return false, reason end
	session.Data.IncomeRemainder = remainder or 0
	session.IncomeClock = math.floor(os.clock() * 1000)
	session.IncomeRate = currentRate
	session.BeforeSave = function() return OnlineIncomeService.Accrue(session) end
	session.UpdateIncomeRate = function()
		local ok, errorCode = OnlineIncomeService.Accrue(session)
		if not ok then return false, errorCode end
		local updatedRate, rateError = rate(session.Data)
		if not updatedRate then return false, rateError end
		session.IncomeRate = updatedRate
		return true
	end
	return true
end

function OnlineIncomeService.Stop(session)
	-- Do not pay for waiting on saves after PlayerRemoving.
	session.IncomeStoppedAt = math.floor(os.clock() * 1000)
end

return OnlineIncomeService
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000022">
      <Properties>
        <string name="Name">PlayerDataStore</string>
        <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local storeName = "NR_Profiles_LIVE_v1"
if RunService:IsStudio() then storeName = "NR_Profiles_DEV_v1" end
local store = DataStoreService:GetDataStore(storeName)
local PlayerDataStore = {}
PlayerDataStore.LeaseSeconds = 120

local function createDefaultData()
	return {
		Balance = Config.StartingBalance, Inventory = {}, IncomeSlots = {},
		InventoryCapacity = Config.StartingInventoryCapacity,
		IncomeSlotCount = Config.StartingIncomeSlots,
	}
end

local function validData(data)
	return type(data) == "table" and type(data.Balance) == "number"
		and data.Balance &gt;= 0 and data.Balance &lt;= 1000000000000 and data.Balance % 1 == 0
		and type(data.Inventory) == "table" and type(data.IncomeSlots) == "table"
		and type(data.InventoryCapacity) == "number" and type(data.IncomeSlotCount) == "number"
end

local function copyTable(source)
	local copy = {}
	for key, value in pairs(source) do
		if type(value) == "table" then copy[key] = copyTable(value) else copy[key] = value end
	end
	return copy
end

function PlayerDataStore.Load(userId)
	local key = "Player_" .. tostring(userId)
	local token = HttpService:GenerateGUID(false)
	local failureReason = "Профиль недоступен"
	local success, record = pcall(function()
		return store:UpdateAsync(key, function(oldRecord)
			local now = os.time()
			if oldRecord == nil then
				oldRecord = {SchemaVersion = 1, Data = createDefaultData()}
			end
			if type(oldRecord) ~= "table" or oldRecord.SchemaVersion ~= 1 or not validData(oldRecord.Data) then
				failureReason = "Неизвестный или повреждённый профиль"
				return nil
			end
			local lock = oldRecord.Session
			if lock ~= nil then
				if type(lock) ~= "table" or type(lock.Id) ~= "string" or type(lock.ExpiresAt) ~= "number" then
					failureReason = "Некорректная блокировка профиля"
					return nil
				end
				if lock.Id ~= token and lock.ExpiresAt &gt; now then
					failureReason = "Профиль ещё открыт другим сервером"
					return nil
				end
			end
			oldRecord.Session = {Id = token, ExpiresAt = now + PlayerDataStore.LeaseSeconds}
			oldRecord.UpdatedAt = now
			return oldRecord
		end)
	end)
	if not success then return nil, tostring(record) end
	if type(record) ~= "table" or type(record.Session) ~= "table" or record.Session.Id ~= token then return nil, failureReason end
	return {UserId = userId, Key = key, Token = token, Data = copyTable(record.Data), LeaseUntil = record.Session.ExpiresAt, Busy = false, Closed = false}
end

function PlayerDataStore.Save(session, release)
	if session.Closed then return true end
	if session.Busy then return false, "Сохранение уже выполняется" end
	if not validData(session.Data) then return false, "Некорректные данные для сохранения" end
	if session.BeforeSave then
		local ok, reason = session.BeforeSave()
		if not ok then return false, reason end
	end
	local snapshot = copyTable(session.Data)
	session.Busy = true
	local failureReason = "Блокировка профиля потеряна"
	local success, record = pcall(function()
		return store:UpdateAsync(session.Key, function(oldRecord)
			local now = os.time()
			if type(oldRecord) ~= "table" or oldRecord.SchemaVersion ~= 1 or type(oldRecord.Session) ~= "table" then return nil end
			local lock = oldRecord.Session
			if lock.Id ~= session.Token or type(lock.ExpiresAt) ~= "number" or lock.ExpiresAt &lt;= now then return nil end
			oldRecord.Data = snapshot
			oldRecord.UpdatedAt = now
			if release then
				oldRecord.Session = nil
			else
				oldRecord.Session = {Id = session.Token, ExpiresAt = now + PlayerDataStore.LeaseSeconds}
			end
			return oldRecord
		end)
	end)
	session.Busy = false
	if not success then return false, tostring(record) end
	if type(record) ~= "table" then return false, failureReason end
	if release then session.Closed = true; session.LeaseUntil = 0 else session.LeaseUntil = record.Session.ExpiresAt end
	return true
end

return PlayerDataStore
</ProtectedString>
